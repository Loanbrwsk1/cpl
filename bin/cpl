#! /bin/bash

WHITE="\e[0m"
YELLOW="\e[33;1m"
RED="\e[31;1m"
GREEN="\e[32;1m"
PURPLE="\e[35;1m"

function displayHelp {
  echo ""
  echo "Usage :"
  echo " cpl [-a/-c] FILE [FILE...] [OPTIONS]"
  echo ""
  echo "Tool to compile code from a code .c or .asm."
  echo ""
  echo "Options :"
  echo "  -a	To compile from ASM code"
  echo "  -c	To compile from C code"
  echo "  -o	To specify a filename for the output. By default, will use the first filename entered without the extension"
  echo "  -x	To execute the code after compiling"
  echo "  -h	Help"
  echo ""
}

while getopts ":a:c:o:xh" option; do
  case $option in
  a)
    OPTION_A=true
    EXT=".asm"
    # Putting all files in a list
    FILES=("$OPTARG")
    while [[ $OPTIND -le $# && "${!OPTIND}" != -* ]]; do
      FILES+=("${!OPTIND}")
      OPTIND=$((OPTIND + 1))
    done
    ;;
  c)
    OPTION_C=true
    EXT=".c"
    # Putting all files in a list
    FILES=("$OPTARG")
    while [[ $OPTIND -le $# && "${!OPTIND}" != -* ]]; do
      FILES+=("${!OPTIND}")
      OPTIND=$((OPTIND + 1))
    done
    ;;
  o)
    OPTION_O=true
    OUTPUT_FILENAME=$OPTARG
    ;;
  x)
    OPTION_X=true
    ;;
  h)
    displayHelp
    exit 0
    ;;
  \?)
    echo -e "${RED}Invalid option ${PURPLE}-$OPTARG${WHITE}"
    exit 1
    ;;
  :)
    echo -e "${RED}File missing !${WHITE}"
    exit 1
    ;;
  esac
done

if [[ "$OPTION_A" != true && "$OPTION_C" != true ]]; then
  echo -e "${YELLOW}You need to enter an option ! For more info :${PURPLE} cpl -h${WHITE}"
  exit 1
fi

# Check if all files are existing
for i in "${!FILES[@]}"; do
  if [[ ! -f "${FILES[i]}$EXT" ]]; then
    f="${FILES[i]}"
    if [[ ! -f "$f" ]]; then
      echo -e "${RED}The file ${PURPLE}$f${RED} doesn't exist !${WHITE}"
      exit 1
    else
      FILES[i]="$f"
    fi
  else
    FILES[i]="$f$EXT"
  fi
done

CODEFILE="${FILES[0]}"

if [[ "$OPTION_A" == true ]]; then
  # Check if nasm and gdb are installed
  if ! nasm -v >/dev/null 2>&1; then
    echo -e "${YELLOW}You should install ${PURPLE}nasm${WHITE}"
    exit 1
  elif ! gdb -v >/dev/null 2>&1; then
    echo -e "${YELLOW}You should install ${PURPLE}gdb${WHITE}"
    exit 1
  fi

  # Check if the extension corresponding with the chosen option
  if [[ "${CODEFILE: -4}" == ".asm" ]]; then
    FILE_WO_EXT="${CODEFILE::-4}"
    FILEO="$FILE_WO_EXT.o"

    if [[ "$OPTION_O" != true ]]; then
      OUTPUT_FILENAME="$FILE_WO_EXT"
    fi

    if ! nasm -f elf64 -g "$CODEFILE" -o "$FILEO"; then
      echo -e "${RED}Error while compiling !${WHITE}"
      exit 1
    fi
    if ! ld "$FILEO" -o "$OUTPUT_FILENAME"; then
      echo -e "${RED}Error while compiling !${WHITE}"
      exit 1
    fi

    echo -e "${GREEN}The file ${PURPLE}$CODEFILE${GREEN} has been compiled successfully into ${PURPLE}$OUTPUT_FILENAME${GREEN} !${WHITE}"
  else
    echo -e "${YELLOW}You are using the wrong option for that type of file !${WHITE}"
    exit 1
  fi

elif [[ "$OPTION_C" == true ]]; then
  # Check if gcc is installed
  if ! gcc -v >/dev/null 2>&1; then
    echo -e "${YELLOW}You should install ${PURPLE}gcc${WHITE}"
    exit 1
  fi

  # Check if the extension corresponding with the chosen option
  if [[ ${CODEFILE: -2} == ".c" ]]; then
    FILE_WO_EXT="${CODEFILE::-2}"

    if [[ "$OPTION_O" != true ]]; then
      OUTPUT_FILENAME="$FILE_WO_EXT"
    fi

    if ! gcc "${FILES[@]}" -o "$OUTPUT_FILENAME"; then
      echo -e "${RED}Error while compiling !${WHITE}"
      exit 1
    fi

    echo -e "${GREEN}The file ${PURPLE}$CODEFILE${GREEN} has been compiled successfully into ${PURPLE}$OUTPUT_FILENAME${GREEN} !${WHITE}"
  else
    echo -e "${YELLOW}You are using the wrong option for that type of file !${WHITE}"
    exit 1
  fi
fi

if [[ "$OPTION_X" == true ]]; then
  echo -e "${GREEN}Launching program...${WHITE}"
  ./"$OUTPUT_FILENAME"
  exit 0
fi

exit 0
