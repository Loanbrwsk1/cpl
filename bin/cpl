#! /bin/bash

RESET_COLOR="\e[0m"
WARNING_COLOR="\e[33;1m"
ERROR_COLOR="\e[31;1m"
SUCCESS_COLOR="\e[32;1m"
ARGUE_COLOR="\e[35;1m"

function displayHelp {
  echo ""
  echo "Usage :"
  echo " cpl [-a/-c] FILE [FILE...] [OPTIONS]"
  echo ""
  echo "Tool to compile code from a code .c or .asm."
  echo ""
  echo "Options :"
  echo "  -a	To compile from ASM code"
  echo "  -c	To compile from C code"
  echo "  -o	To specify a filename for the output. By default, will use the first filename entered without the extension"
  echo "  -x	To execute the code after compiling"
  echo "  -h	Help"
  echo ""
}

while getopts ":a:c:o:xh" option; do
  case $option in
  a)
    OPTION_A=true
    EXT=".asm"
    FILES=("$OPTARG")
    while [[ $OPTIND -le $# && "${!OPTIND}" != -* ]]; do
      FILES+=("${!OPTIND}")
      OPTIND=$((OPTIND + 1))
    done
    ;;
  c)
    OPTION_C=true
    EXT=".c"
    FILES=("$OPTARG")
    while [[ $OPTIND -le $# && "${!OPTIND}" != -* ]]; do
      FILES+=("${!OPTIND}")
      OPTIND=$((OPTIND + 1))
    done
    ;;
  o)
    OPTION_O=true
    OUTPUT_FILENAME=$OPTARG
    ;;
  x)
    OPTION_X=true
    ;;
  h)
    displayHelp
    exit 0
    ;;
  \?)
    echo -e "${ERROR_COLOR}Invalid option ${ARGUE_COLOR}-$OPTARG${RESET_COLOR}"
    exit 1
    ;;
  :)
    echo -e "${ERROR_COLOR}File missing !${RESET_COLOR}"
    exit 1
    ;;
  esac
done

if [[ "$OPTION_A" != true && "$OPTION_C" != true ]]; then
  echo -e "${WARNING_COLOR}You need to enter an option ! For more info :${ARGUE_COLOR} cpl -h${RESET_COLOR}"
  exit 1
fi

for i in "${!FILES[@]}"; do
  if [[ ! -f "${FILES[i]}$EXT" ]]; then
    f="${FILES[i]}"
    if [[ ! -f "$f" ]]; then
      echo -e "${ERROR_COLOR}The file ${ARGUE_COLOR}$f${ERROR_COLOR} doesn't exist !${RESET_COLOR}"
      exit 1
    else
      FILES[i]="$f"
    fi
  else
    FILES[i]="$f$EXT"
  fi
done

CODEFILE="${FILES[0]}"

if [[ "$OPTION_A" == true ]]; then
  if ! nasm -v >/dev/null 2>&1; then
    echo -e "${WARNING_COLOR}You should install ${ARGUE_COLOR}nasm${RESET_COLOR}"
    exit 1
  elif ! gdb -v >/dev/null 2>&1; then
    echo -e "${WARNING_COLOR}You should install ${ARGUE_COLOR}gdb${RESET_COLOR}"
    exit 1
  fi

  if [[ "${CODEFILE: -4}" == ".asm" ]]; then
    FILE_WO_EXT="${CODEFILE::-4}"
    FILEO="$FILE_WO_EXT.o"

    if [[ "$OPTION_O" != true ]]; then
      OUTPUT_FILENAME="$FILE_WO_EXT"
    fi

    if ! nasm -f elf64 -g "$CODEFILE" -o "$FILEO"; then
      echo -e "${ERROR_COLOR}Error while compiling !${RESET_COLOR}"
      exit 1
    fi
    if ! ld "$FILEO" -o "$OUTPUT_FILENAME"; then
      echo -e "${ERROR_COLOR}Error while compiling !${RESET_COLOR}"
      exit 1
    fi

    echo -e "${SUCCESS_COLOR}The file ${ARGUE_COLOR}$CODEFILE${SUCCESS_COLOR} has been compiled successfully into ${ARGUE_COLOR}$OUTPUT_FILENAME${SUCCESS_COLOR} !${RESET_COLOR}"
  else
    echo -e "${WARNING_COLOR}You are using the wrong option for that type of file !${RESET_COLOR}"
    exit 1
  fi

elif [[ "$OPTION_C" == true ]]; then
  if ! gcc -v >/dev/null 2>&1; then
    echo -e "${WARNING_COLOR}You should install ${ARGUE_COLOR}gcc${RESET_COLOR}"
    exit 1
  fi

  if [[ ${CODEFILE: -2} == ".c" ]]; then
    FILE_WO_EXT="${CODEFILE::-2}"

    if [[ "$OPTION_O" != true ]]; then
      OUTPUT_FILENAME="$FILE_WO_EXT"
    fi

    if ! gcc "${FILES[@]}" -o "$OUTPUT_FILENAME"; then
      echo -e "${ERROR_COLOR}Error while compiling !${RESET_COLOR}"
      exit 1
    fi

    echo -e "${SUCCESS_COLOR}The file ${ARGUE_COLOR}$CODEFILE${SUCCESS_COLOR} has been compiled successfully into ${ARGUE_COLOR}$OUTPUT_FILENAME${SUCCESS_COLOR} !${RESET_COLOR}"
  else
    echo -e "${WARNING_COLOR}You are using the wrong option for that type of file !${RESET_COLOR}"
    exit 1
  fi
fi

if [[ "$OPTION_X" == true ]]; then
  echo -e "${SUCCESS_COLOR}Launching program...${RESET_COLOR}"
  ./"$OUTPUT_FILENAME"
  exit 0
fi

exit 0
